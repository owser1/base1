&НаКлиенте
Асинх Процедура ПриИзмененииСогласованнойСкидки(Элемент)
	//++ Журавлева_______________, 11.09.2026
	//Проверяю, если нет ни товаров ни услуг, тогда сообщение о пересчете не выводится
	ТекущиеДанныеТовары = Элементы.Товары.ТекущиеДанные;
	ТекущиеДанныеУслуги = Элементы.Услуги.ТекущиеДанные;

	Если ТекущиеДанныеТовары = Неопределено И ТекущиеДанныеУслуги = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Вопрос = ВопросАсинх("Изменен процент скидки. Пересчитать таблицу товаров и услуг?", РежимДиалогаВопрос.ДаНет);
	ОтветНаВопрос = Ждать Вопрос;
	
	//Если ответ ДА, то делаю пересчет всех строчек таблицы
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		
		ПересчетТаблицыСоСкидкой();
		
	КонецЕсли;
	//--
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПересчитатьТаблицу(Команда)
	//++ Журавлева_______________, 11.09.2026
	//Создаю обработчик для команды
	ПересчетТаблицыСоСкидкой();
	//--
	 
 КонецПроцедуры
 
 &НаКлиенте
Процедура ПересчетТаблицыСоСкидкой()
	//++ Журавлева_______________, 11.09.2026
	//Пересчитываю данные с учетом скидки построчно
	Для Каждого ТекущиеДанные из Объект.Товары Цикл
		
		РассчитатьСуммуСтроки(ТекущиеДанные);
		
	КонецЦикла;
	
	Для Каждого ТекущиеДанные из Объект.Услуги Цикл
		
		РассчитатьСуммуСтроки(ТекущиеДанные);
		
	КонецЦикла;
	
	РассчитатьСуммуДокумента();
	
	//==
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
			
	//++ Журавлева_______________, 11.09.2026
	//Изменяю порядок расчета с учетом скидки
	//Исходный код:
	//КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	//Новый Код:
	Если Объект.КЛ_СогласованнаяСкидка + ТекущиеДанные.Скидка > 100 Тогда
		ТекущиеДанные.Сумма = 0;
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = ("Скидка больше 100%");
		Сообщение.Сообщить();
	Иначе
		ТекущиеДанные.Сумма = (ТекущиеДанные.Цена - ТекущиеДанные.Цена * (Объект.КЛ_СогласованнаяСкидка + ТекущиеДанные.Скидка) / 100) * ТекущиеДанные.Количество;
	КонецЕсли;

	РассчитатьСуммуДокумента();
	//--
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

